# Copie este arquivo para .env e preencha com os valores reais.
# Nunca comite o arquivo .env no git.

VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
VITE_SITE_URL=https://romolina.com.br

# --- Recebimento de leads do Grupo OLX (/api/leads/grupozap) ---------------
# Só as funções serverless leem estas variáveis. Não use prefixo VITE_: isso
# as colocaria dentro do JavaScript público do site.

# Chave service_role do Supabase (Project Settings → API). O anon key não tem
# permissão de INSERT em leads — de propósito, para ninguém forjar lead de portal.
SUPABASE_SERVICE_ROLE_KEY=

# Token exigido no POST do Canal Pro. Vai no fim da URL de integração
# (?token=...). Se ficar vazio, o endpoint aceita qualquer POST.
GRUPOZAP_LEAD_SECRET=
